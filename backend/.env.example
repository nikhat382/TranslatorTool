# API Keys for Translation Services

# OpenAI API Key (optional - for GPT-4 Vision translation)
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Gemini API Key (required for image translation - FREE!)
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API Key (optional - for Claude translations)
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# JWT Authentication Settings (for user login and cost tracking)
# IMPORTANT: Change this to a strong random string in production!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-change-this-in-production-use-strong-random-string
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS configuration)
FRONTEND_URL=http://localhost:5173

# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration (SQLite)
# Database file will be created automatically at: backend/data/translator.db
# No additional configuration needed for SQLite
